<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for EzyEnquiry RetailerApp.
  - Production: HTTPS only (no cleartext)
  - Development: allow cleartext to local dev IPs (10.0.2.2, localhost, 192.168.*)

  ⚠️ IMPORTANT — the `<domain-config>` block below is an ALLOW-LIST.
  Android 9+ blocks cleartext HTTP by default, so ANY `http://` host the app talks
  to must be listed here or the request fails. Symptom is the same generic
  "Request timed out. Please check your connection and try again." as a wrong IP,
  which makes this easy to misdiagnose as a Wi-Fi problem.

  If you set `API_HOST` to a local dev server (see src/config/env.js), add that
  machine's current LAN IP to this list — a missing entry fails even when the
  backend is running and reachable.

  The production host is HTTPS and needs no entry here.
-->
<network-security-config>
    <!-- Production: HTTPS only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Development: allow cleartext to local IPs for Metro and backend -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

    <!-- Local dev servers. Add your machine's LAN IP here when using API_HOST=LOCAL_HOST. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="true">192.168.1.45</domain>
        <!-- Current dev machine LAN IPs (2026-09-30) — replace when the network changes -->
        <domain includeSubdomains="false">10.20.40.30</domain>
        <domain includeSubdomains="false">10.170.88.167</domain>
    </domain-config>
</network-security-config>
